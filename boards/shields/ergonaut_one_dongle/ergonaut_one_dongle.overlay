/ {
    chosen {
        zephyr,display = &st7789;
        zmk,backlight = &disp_bl;
    };

    /* Rétroéclairage PWM sur la broche P1.04 */
    pwm_leds: pwm_leds {
        compatible = "pwm-leds";
        disp_bl: disp_bl {
            pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_INVERTED>;
            label = "Backlight PWM";
        };
    };
};

/* Configuration du bus SPI1 et du contrôleur d'écran */
&spi1 {
    status = "okay";
    cs-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;

    st7789: st7789@0 {
        compatible = "sitronix,st7789v";
        reg = <0>;
        spi-max-frequency = <20000000>;
        
        /* Propriétés MIPI requises par le module Prospector */
        mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
        mipi-max-frequency = <20000000>;

        /* Broches de contrôle */
        cmd-data-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
        
        /* Paramètres physiques et d'initialisation */
        width = <240>;
        height = <240>;
        x-offset = <0>;
        y-offset = <0>;
        vcom = <0x19>;
        gctrl = <0x35>;
        vrhs = <0x12>;
        vdvs = <0x20>;
        mdac = <0x00>;
        gamma = <0x01>;
        colmod = <0x05>;
        lcm = <0x2c>;
        porch-param = [0c 0c 00 33 33];
        cmd2bk = [04 2f 11 42 02];
        pvgamctrl = [d0 04 0d 11 13 2b 3f 54 4c 18 0d 0b 1f 23];
        nvgamctrl = [d0 04 0c 11 13 2c 3f 44 51 2f 1f 1f 20 23];
    };
};
